      "name": "Test 1 - All fields valid (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Rahim Ahmed\",\n  \"email\": \"rahim@gmail.com\",\n  \"password\": \"Rahim@123\",\n  \"age\": 22,\n  \"phone\": \"01712345678\",\n  \"accountType\": \"student\",\n  \"address\": \"Dhaka, Bangladesh\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "register"
          ]
        }
      }
